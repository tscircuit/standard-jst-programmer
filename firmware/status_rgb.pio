; XL-1615RGBC-2812B-S: GRB/MSB-first, 0.3/0.9 us high, 1.2 us bit period.
; At 10 MHz each path is 12 cycles. An empty FIFO stalls with the pin low.
.program status_rgb
.side_set 1
.wrap_target
bitloop:
    out x, 1       side 0 [2]
    jmp !x bit_zero    side 1 [2]
    jmp bitloop    side 1 [5]
bit_zero:
    nop            side 0 [5]
.wrap
